{
  "name": "promptboard",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first workspace to compose prompts, run coding tasks on Kanban boards, and reuse agent profiles, skills, and knowledge.",
  "keywords": [
    "ai",
    "coding-agent",
    "kanban",
    "prompt-engineering",
    "claude-code",
    "codex",
    "gemini-cli",
    "git-worktree",
    "local-first"
  ],
  "homepage": "https://github.com/datasound-projects/Promptboard#readme",
  "bugs": {
    "url": "https://github.com/datasound-projects/Promptboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datasound-projects/Promptboard.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ste-prompt": "bin/ste.mjs"
  },
  "scripts": {
    "start": "node bin/ste.mjs --gui",
    "start:no-open": "node bin/ste.mjs --gui --no-open",
    "test": "node --test --test-concurrency=2 --test-timeout=180000 --test-force-exit tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "eval:live": "node scripts/evaluate.mjs",
    "bench": "node scripts/benchmark.mjs",
    "bench:pipeline": "node scripts/pipeline-bench.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  }
}
